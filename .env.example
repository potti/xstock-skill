# Copy to `.env` and fill in. Never commit `.env`.

# Integration test (jupiter_quote.integration.test.js)
RUN_INTEGRATION=1
INTEGRATION_WALLET=
# Paid / low-latency RPC avoids Connect Timeout on public mainnet-beta
INTEGRATION_RPC=https://api.mainnet-beta.solana.com
INTEGRATION_FETCH_TIMEOUT_MS=120000
INTEGRATION_SLIPPAGE_BPS=100
# INTEGRATION_SIMULATE_SIGNED=1
# INTEGRATION_BROADCAST=1

# Signing (same names as OpenClaw / scripts)
# OPENCLAW_SOLANA_SECRET=
# SOLANA_SECRET_BASE58=
